# Production secrets and public URLs
#
# Canonical hostname-based deployment for this project.
# Copy this file to .env.production and keep secret values in the referenced
# operator-managed files, never in this file.
# This example is aligned with docker-compose.production.yml where backend, data, secret and ops planes stay private-only.
# Public exposure in the production baseline is limited to nginx 80/443 and jitsi-jvb 10000/udp.
# Vault now serves as the source of truth for production secret delivery; this file keeps only non-secret config and path hints.
SPRING_PROFILES_ACTIVE=prod

# Nginx baseline mounts
NGINX_PORTAL_CONFIG_PATH=./deploy/nginx/portal.conf.example
NGINX_CERTS_PATH=/etc/letsencrypt
PORTAL_HOST=jitsi-mgorka.top
AUTH_HOST=auth.jitsi-mgorka.top
MEET_HOST=meet.jitsi-mgorka.top
TLS_CERT_NAME=jitsi-mgorka.top

# Public application URLs
APP_FRONTEND_ORIGIN=https://jitsi-mgorka.top
APP_OPENAPI_SERVER_URL=https://jitsi-mgorka.top
APP_SECURITY_JWT_ISSUER=https://jitsi-mgorka.top
APP_SECURITY_JWT_ALGORITHM=HS256
APP_MEETINGS_TOKEN_ISSUER=https://jitsi-mgorka.top
APP_MEETINGS_TOKEN_JOIN_URL_TEMPLATE=https://meet.jitsi-mgorka.top/%s#jwt=%s
APP_MEETINGS_SERVICE_URL=https://jitsi-mgorka.top/api/v1
APP_MEETINGS_TOKEN_AUDIENCE=jitsi-meet
APP_MEETINGS_TOKEN_ROLE_CLAIM_NAME=role
APP_MEETINGS_TOKEN_ALGORITHM=HS256

# Backend non-secret app settings
SSO_CLIENT_ID=jitsi-backend

# OIDC / Keycloak public and internal endpoints
SSO_AUTHORIZATION_URI=https://auth.jitsi-mgorka.top/realms/jitsi/protocol/openid-connect/auth
# Back-channel OIDC calls stay on identity_net; tokens still use the public issuer below.
SSO_TOKEN_URI=http://keycloak:8080/realms/jitsi/protocol/openid-connect/token
SSO_JWK_SET_URI=http://keycloak:8080/realms/jitsi/protocol/openid-connect/certs
SSO_USER_INFO_URI=http://keycloak:8080/realms/jitsi/protocol/openid-connect/userinfo
APP_SECURITY_SSO_EXPECTED_ISSUER=https://auth.jitsi-mgorka.top/realms/jitsi

# Vault bootstrap handoff paths for backend-vault-bootstrap
# These files stay operator-managed outside git history; example paths are placeholders for compose rendering only.
VAULT_TLS_DIR=/etc/jitsi-prod/vault/tls
VAULT_RECOVERY_DIR=/etc/jitsi-prod/vault/recovery
VAULT_SEED_ENV_FILE_PATH=/etc/jitsi-prod/vault/seed.env
BACKEND_VAULT_HANDOFF_DIR=/etc/jitsi-prod/vault/backend
BACKEND_VAULT_ROLE_ID_PATH=/etc/jitsi-prod/vault/backend/role_id
BACKEND_VAULT_WRAPPED_SECRET_ID_PATH=/etc/jitsi-prod/vault/backend/wrapped-secret-id

# Service-specific Vault delivery surfaces
# The example points to non-secret fixtures only so static Compose rendering is
# reproducible. A real .env.production must use root-owned paths outside git.
POSTGRES_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/postgres.env.example
REDIS_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/redis.env.example
KEYCLOAK_POSTGRES_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/keycloak-postgres.env.example
KEYCLOAK_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/keycloak.env.example
JITSI_WEB_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/jitsi-web.env.example
JITSI_PROSODY_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/jitsi-prosody.env.example
JITSI_JICOFO_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/jitsi-jicofo.env.example
JITSI_JVB_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/jitsi-jvb.env.example
GRAFANA_VAULT_ENV_FILE_PATH=./deploy/vault/delivery/examples/grafana.env.example

# Database and Redis
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/jitsi
SPRING_DATASOURCE_USERNAME=jitsi
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
POSTGRES_DB=jitsi
POSTGRES_USER=jitsi

# Keycloak bootstrap and hostname
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=jitsi-bootstrap-admin
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_REALM_IMPORT_DIR=./pilot/keycloak/realm/production
KC_HOSTNAME=https://auth.jitsi-mgorka.top
# Production compose pins nginx to 172.28.240.10 on identity_net so Keycloak trusts only the strict edge by default.
KC_PROXY_TRUSTED_ADDRESSES=172.28.240.10

# Jitsi JWT and public entrypoint
JWT_APP_ID=https://jitsi-mgorka.top
JWT_ACCEPTED_ISSUERS=https://jitsi-mgorka.top
JWT_ACCEPTED_AUDIENCES=jitsi-meet
PUBLIC_URL=https://meet.jitsi-mgorka.top
JVB_ADVERTISE_IPS=10.10.100.29,86.57.222.216

# IP-only bootstrap values intentionally live in docs/deployment-production.md and deploy/nginx/portal-ip.conf.example.
# This template tracks the hardened hostname-based production baseline only.

# Optional observability
# Monitoring endpoints belong to the private ops path from docker-compose.production.monitoring.yml and must not be published directly.
APP_FEATURES_ADVANCED_MONITORING=false
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
MONITORING_ENVIRONMENT=prod
MONITORING_SERVICE_NAME=jitsi-backend
