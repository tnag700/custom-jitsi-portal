# Docker Compose local configuration (development only)
KEYCLOAK_ADMIN=jitsi-admin

# Network bindings and browser-visible origins.
# Keep localhost for same-machine development. When the portal is opened from
# another workstation, replace localhost with the dev host address in every
# *_ORIGIN and DEV_PUBLIC_API_URL value so OAuth callbacks stay consistent.
DEV_FRONTEND_PORT=3000
DEV_BACKEND_PORT=8080
DEV_BACKEND_ORIGIN=http://localhost:8080
DEV_PUBLIC_API_URL=http://localhost:8080/api/v1
DEV_KEYCLOAK_PORT=8081
DEV_KEYCLOAK_ORIGIN=http://localhost:8081
DEV_PORTAL_ORIGIN=http://localhost:3000
DEV_SWAGGER_PORT=8082
DEV_JITSI_HTTP_PORT=8000
DEV_JITSI_HTTPS_PORT=8443

# Optional development Vault seed overrides.
# Runtime consumers read secrets from Vault-managed delivery surfaces,
# but these values let you customize what the local bootstrap writes into Vault.
DEV_VAULT_POSTGRES_USERNAME=jitsi
DEV_VAULT_POSTGRES_PASSWORD=dev-postgres-password
DEV_VAULT_REDIS_PASSWORD=dev-redis-password
DEV_VAULT_KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin-password
DEV_VAULT_SSO_CLIENT_SECRET=jitsi-dev-client-secret
DEV_VAULT_APP_MEETINGS_TOKEN_SIGNING_SECRET=01234567890123456789012345678901
DEV_VAULT_APP_CONFIG_SETS_ENCRYPTION_KEY=0123456789ABCDEF0123456789ABCDEF
DEV_VAULT_JICOFO_AUTH_PASSWORD=focus
DEV_VAULT_JVB_AUTH_PASSWORD=jvb
DEV_VAULT_JICOFO_COMPONENT_SECRET=focussecret

# Monitoring hardening: avoid default admin/admin in Grafana.
GF_SECURITY_ADMIN_PASSWORD=replace-with-strong-password

# Comma-separated allowlist for external logout redirects (for example IdP logout endpoint origins).
AUTH_LOGOUT_ALLOWED_ORIGINS=
