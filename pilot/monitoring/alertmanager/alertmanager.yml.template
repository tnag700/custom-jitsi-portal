global:
  resolve_timeout: 5m

route:
  group_by:
    - alertname
    - environment
    - service
  group_wait: 15s
  group_interval: 1m
  repeat_interval: 4h
  receiver: default-webhook

receivers:
  - name: default-webhook
    webhook_configs:
      - url: "__ALERTMANAGER_WEBHOOK_URL__"
        send_resolved: true
