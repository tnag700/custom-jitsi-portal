#!/bin/sh
set -eu

export VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
ROLE_NAME="${ROLE_NAME:-backend-service}"

echo "Write the committed role template to auth/approle-workloads/role/${ROLE_NAME} first, then hand off the wrapping token through a private channel only."
vault write -wrap-ttl=5m -f "auth/approle-workloads/role/${ROLE_NAME}/secret-id"