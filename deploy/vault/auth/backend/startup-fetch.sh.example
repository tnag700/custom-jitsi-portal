#!/bin/sh
set -eu

export VAULT_ADDR="${VAULT_ADDR:-https://vault:8200}"
case "$VAULT_ADDR" in
  https://*) export VAULT_CACERT="${VAULT_CACERT:-/vault/tls/ca.crt}" ;;
esac

ROLE_ID_FILE="${ROLE_ID_FILE:-/vault/local/backend/role_id}"
WRAPPED_SECRET_ID_FILE="${WRAPPED_SECRET_ID_FILE:-/vault/local/backend/wrapped-secret-id}"
TOKEN_SINK_FILE="${TOKEN_SINK_FILE:-/vault/runtime/backend-batch-token}"
BACKEND_ENV_OUTPUT_FILE="${BACKEND_ENV_OUTPUT_FILE:-/vault/runtime/backend/runtime.env}"
BACKEND_APP_SECRET_PATH="${BACKEND_APP_SECRET_PATH:-kv/app/backend/runtime}"
BACKEND_OIDC_SECRET_PATH="${BACKEND_OIDC_SECRET_PATH:-kv/identity/backend/oidc}"
BACKEND_REDIS_SECRET_PATH="${BACKEND_REDIS_SECRET_PATH:-kv/app/redis/runtime}"
BACKEND_DB_STATIC_CREDENTIAL_PATH="${BACKEND_DB_STATIC_CREDENTIAL_PATH:-database/static-creds/backend-app}"
BACKEND_DB_DYNAMIC_CREDENTIAL_PATH="${BACKEND_DB_DYNAMIC_CREDENTIAL_PATH:-database/creds/backend-app}"
OUTPUT_UID="${OUTPUT_UID:-10001}"
OUTPUT_GID="${OUTPUT_GID:-10001}"

runtime_bridge_is_complete() {
  test -s "$BACKEND_ENV_OUTPUT_FILE" || return 1
  for key in \
    APP_MEETINGS_TOKEN_SIGNING_SECRET \
    APP_CONFIG_SETS_ENCRYPTION_KEY \
    SSO_CLIENT_SECRET \
    SPRING_DATA_REDIS_PASSWORD \
    SPRING_DATASOURCE_USERNAME \
    SPRING_DATASOURCE_PASSWORD \
    BACKEND_DB_ROTATION_CONTRACT \
    BACKEND_DB_VAULT_SOURCE
  do
    grep -q "^export ${key}='" "$BACKEND_ENV_OUTPUT_FILE" || return 1
    if grep -q "^export ${key}=''$" "$BACKEND_ENV_OUTPUT_FILE"; then
      return 1
    fi
  done
}

# Compose may start a completed one-shot dependency again on a later `up`.
# Reuse the protected runtime bridge rather than attempting to unwrap the
# intentionally one-use SecretID a second time.
if runtime_bridge_is_complete; then
  echo "Backend runtime env bridge is already complete; no Vault handoff was consumed."
  exit 0
fi

shell_escape() {
  printf '%s' "$1" | sed "s/'/'\\''/g"
}

write_export() {
  key="$1"
  value="$2"
  if [ -z "$value" ]; then
    echo "Refusing to render an empty required backend secret: $key" >&2
    exit 1
  fi
  escaped_value="$(shell_escape "$value")"
  printf "export %s='%s'\n" "$key" "$escaped_value" >> "$BACKEND_ENV_OUTPUT_FILE"
}

read_kv_field() {
  path="$1"
  field="$2"
  vault kv get -field="$field" "$path"
}

read_db_field() {
  path="$1"
  field="$2"
  vault read -field="$field" "$path"
}

if [ ! -f "$ROLE_ID_FILE" ]; then
  echo "role_id file is missing: $ROLE_ID_FILE" >&2
  exit 1
fi

if [ ! -f "$WRAPPED_SECRET_ID_FILE" ]; then
  echo "wrapped secret_id file is missing: $WRAPPED_SECRET_ID_FILE" >&2
  exit 1
fi

ROLE_ID="$(tr -d '\r\n' < "$ROLE_ID_FILE")"
WRAPPED_SECRET_ID="$(tr -d '\r\n' < "$WRAPPED_SECRET_ID_FILE")"
SECRET_ID="$(VAULT_TOKEN="$WRAPPED_SECRET_ID" vault unwrap -field=secret_id)"
TOKEN="$(vault write -field=token auth/approle-workloads/login role_id="$ROLE_ID" secret_id="$SECRET_ID")"

umask 077
mkdir -p "$(dirname "$TOKEN_SINK_FILE")"
printf '%s' "$TOKEN" > "$TOKEN_SINK_FILE"

BACKEND_ENV_DIR="$(dirname "$BACKEND_ENV_OUTPUT_FILE")"
mkdir -p "$BACKEND_ENV_DIR"
chmod 0700 "$BACKEND_ENV_DIR"
chown "$OUTPUT_UID:$OUTPUT_GID" "$BACKEND_ENV_DIR"
: > "$BACKEND_ENV_OUTPUT_FILE"

export VAULT_TOKEN="$TOKEN"

write_export APP_MEETINGS_TOKEN_SIGNING_SECRET "$(read_kv_field "$BACKEND_APP_SECRET_PATH" APP_MEETINGS_TOKEN_SIGNING_SECRET)"
write_export APP_CONFIG_SETS_ENCRYPTION_KEY "$(read_kv_field "$BACKEND_APP_SECRET_PATH" APP_CONFIG_SETS_ENCRYPTION_KEY)"
write_export SSO_CLIENT_SECRET "$(read_kv_field "$BACKEND_OIDC_SECRET_PATH" SSO_CLIENT_SECRET)"
write_export SPRING_DATA_REDIS_PASSWORD "$(read_kv_field "$BACKEND_REDIS_SECRET_PATH" REDIS_PASSWORD)"

if read_db_field "$BACKEND_DB_STATIC_CREDENTIAL_PATH" username >/dev/null 2>&1; then
  write_export SPRING_DATASOURCE_USERNAME "$(read_db_field "$BACKEND_DB_STATIC_CREDENTIAL_PATH" username)"
  write_export SPRING_DATASOURCE_PASSWORD "$(read_db_field "$BACKEND_DB_STATIC_CREDENTIAL_PATH" password)"
  write_export BACKEND_DB_ROTATION_CONTRACT "controlled-restart-static-role"
  write_export BACKEND_DB_VAULT_SOURCE "$BACKEND_DB_STATIC_CREDENTIAL_PATH"
else
  write_export SPRING_DATASOURCE_USERNAME "$(read_db_field "$BACKEND_DB_DYNAMIC_CREDENTIAL_PATH" username)"
  write_export SPRING_DATASOURCE_PASSWORD "$(read_db_field "$BACKEND_DB_DYNAMIC_CREDENTIAL_PATH" password)"
  write_export BACKEND_DB_ROTATION_CONTRACT "lease-based-controlled-restart"
  write_export BACKEND_DB_VAULT_SOURCE "$BACKEND_DB_DYNAMIC_CREDENTIAL_PATH"
fi

chmod 0600 "$BACKEND_ENV_OUTPUT_FILE"
chown "$OUTPUT_UID:$OUTPUT_GID" "$BACKEND_ENV_OUTPUT_FILE"

rm -f "$TOKEN_SINK_FILE"

unset VAULT_TOKEN WRAPPED_SECRET_ID SECRET_ID TOKEN ROLE_ID
echo "Backend startup fetch completed. The runtime env bridge is ready and the temporary token sink has been removed."
