#!/bin/sh
set -eu

SECRETS_FILE="${BACKEND_SECRETS_FILE:-/vault/runtime/backend/runtime.env}"
EXPECTED_DB_USER="${SPRING_DATASOURCE_USERNAME:?expected runtime database user is required}"

if [ ! -r "$SECRETS_FILE" ]; then
  echo "backend secrets file is missing: $SECRETS_FILE" >&2
  exit 1
fi

set -a
. "$SECRETS_FILE"
set +a

if [ "$SPRING_DATASOURCE_USERNAME" != "$EXPECTED_DB_USER" ] ||
   [ "${BACKEND_DB_ROTATION_CONTRACT:-}" != "manual-static-kv-controlled-restart" ]; then
  echo "Backend database handoff is stale; migrate the runtime role and refresh the Vault bridge." >&2
  exit 1
fi

exec "$@"
