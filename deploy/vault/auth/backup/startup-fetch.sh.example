#!/bin/sh
set -eu

export VAULT_ADDR="${VAULT_ADDR:-http://vault:8200}"

ROLE_ID_FILE="${ROLE_ID_FILE:-/vault/local/backup/role_id}"
WRAPPED_SECRET_ID_FILE="${WRAPPED_SECRET_ID_FILE:-/vault/local/backup/wrapped-secret-id}"
TOKEN_SINK_FILE="${TOKEN_SINK_FILE:-/vault/runtime/backup-runner-batch-token}"

if [ ! -f "$ROLE_ID_FILE" ]; then
  echo "role_id file is missing: $ROLE_ID_FILE" >&2
  exit 1
fi

if [ ! -f "$WRAPPED_SECRET_ID_FILE" ]; then
  echo "wrapped secret_id file is missing: $WRAPPED_SECRET_ID_FILE" >&2
  exit 1
fi

ROLE_ID="$(tr -d '\r\n' < "$ROLE_ID_FILE")"
WRAPPED_SECRET_ID="$(tr -d '\r\n' < "$WRAPPED_SECRET_ID_FILE")"
SECRET_ID="$(VAULT_TOKEN="$WRAPPED_SECRET_ID" vault unwrap -field=secret_id)"
TOKEN="$(vault write -field=token auth/approle-workloads/login role_id="$ROLE_ID" secret_id="$SECRET_ID")"

umask 077
printf '%s' "$TOKEN" > "$TOKEN_SINK_FILE"

unset WRAPPED_SECRET_ID SECRET_ID TOKEN ROLE_ID
echo "Backup runner startup fetch completed. Remove the token sink after the downstream handoff finishes."