# Render this file through the official nginx Docker entrypoint template path.
# Required envsubst inputs: PORTAL_HOST, AUTH_HOST and MEET_HOST.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

log_format edge_combined 'request_id=$request_id remote_addr=$remote_addr host=$host '
    'request="$request" status=$status body_bytes_sent=$body_bytes_sent '
    'request_time=$request_time upstream_addr=$upstream_addr upstream_status=$upstream_status '
    'upstream_response_time=$upstream_response_time referer="$http_referer" user_agent="$http_user_agent"';

limit_req_zone $binary_remote_addr zone=auth_sensitive:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=api_sensitive:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=per_ip_conn:10m;

upstream frontend_upstream {
    server frontend:3000;
}

upstream backend_upstream {
    server backend:8080;
}

upstream keycloak_upstream {
    server keycloak:8080;
}

upstream jitsi_web_upstream {
    server jitsi-web:8000;
}

server {
    listen 8080;
    listen [::]:8080;
    server_name ${PORTAL_HOST} ${AUTH_HOST} ${MEET_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${PORTAL_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:portal_ssl:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;

    access_log /var/log/nginx/access.log edge_combined;
    server_tokens off;
    autoindex off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;
    proxy_buffering on;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    limit_conn per_ip_conn 20;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Original-Forwarded-For "";
    proxy_set_header X-Original-URL "";
    proxy_set_header X-Original-Method "";
    proxy_set_header X-Forwarded-Access-Token "";
    proxy_set_header traceparent "";
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    proxy_set_header b3 "";
    proxy_set_header x-b3-traceid "";
    proxy_set_header x-b3-spanid "";
    proxy_set_header x-b3-parentspanid "";
    proxy_set_header x-b3-sampled "";
    proxy_set_header x-b3-flags "";
    proxy_set_header uber-trace-id "";
    proxy_set_header x-ot-span-context "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    location ^~ /actuator/ {
        return 404;
    }

    location ~* ^/(swagger-ui|swagger-ui\.html|v3/api-docs|api-docs|prometheus|metrics|env|configprops)(/|$) {
        return 404;
    }

    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
    }

    location ^~ /api/v1/auth/ {
        limit_req zone=api_sensitive burst=20 nodelay;
        limit_conn per_ip_conn 10;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
    }

    location ^~ /login/oauth2/ {
        limit_req zone=auth_sensitive burst=10 nodelay;
        limit_conn per_ip_conn 10;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
    }

    location ^~ /oauth2/ {
        limit_req zone=auth_sensitive burst=10 nodelay;
        limit_conn per_ip_conn 10;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
    }

    location = /actuator/health {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${AUTH_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:auth_ssl:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    access_log /var/log/nginx/access.log edge_combined;
    server_tokens off;
    autoindex off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;
    proxy_buffering on;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    limit_conn per_ip_conn 20;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Original-Forwarded-For "";
    proxy_set_header X-Original-URL "";
    proxy_set_header X-Original-Method "";
    proxy_set_header X-Forwarded-Access-Token "";
    proxy_set_header traceparent "";
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    proxy_set_header b3 "";
    proxy_set_header x-b3-traceid "";
    proxy_set_header x-b3-spanid "";
    proxy_set_header x-b3-parentspanid "";
    proxy_set_header x-b3-sampled "";
    proxy_set_header x-b3-flags "";
    proxy_set_header uber-trace-id "";
    proxy_set_header x-ot-span-context "";

    location = / {
        return 404;
    }

    location = /admin {
        return 403;
    }

    location ^~ /admin/ {
        return 403;
    }

    location = /realms/master {
        return 403;
    }

    location ^~ /realms/master/ {
        return 403;
    }

    location ~* ^/(metrics|health)(/|$) {
        return 404;
    }

    location ~* ^/realms/[^/]+/(metrics|health)(/|$) {
        return 404;
    }

    location ~* ^/realms/[^/]+/protocol/openid-connect/(auth|token|device|logout|registrations)(/|$) {
        limit_req zone=auth_sensitive burst=10 nodelay;
        limit_conn per_ip_conn 10;
        proxy_pass http://keycloak_upstream;
        proxy_http_version 1.1;
    }

    location /realms/ {
        proxy_pass http://keycloak_upstream;
        proxy_http_version 1.1;
    }

    location ^~ /resources/ {
        proxy_pass http://keycloak_upstream;
        proxy_http_version 1.1;
    }

    location ^~ /.well-known/ {
        proxy_pass http://keycloak_upstream;
        proxy_http_version 1.1;
    }

    location / {
        return 404;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    http2 on;
    server_name ${MEET_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:meet_ssl:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    access_log /var/log/nginx/access.log edge_combined;
    server_tokens off;
    autoindex off;
    client_max_body_size 2m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 30s;
    proxy_buffering on;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;
    proxy_busy_buffers_size 32k;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    limit_conn per_ip_conn 20;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Original-Forwarded-For "";
    proxy_set_header X-Original-URL "";
    proxy_set_header X-Original-Method "";
    proxy_set_header X-Forwarded-Access-Token "";
    proxy_set_header traceparent "";
    proxy_set_header tracestate "";
    proxy_set_header baggage "";
    proxy_set_header b3 "";
    proxy_set_header x-b3-traceid "";
    proxy_set_header x-b3-spanid "";
    proxy_set_header x-b3-parentspanid "";
    proxy_set_header x-b3-sampled "";
    proxy_set_header x-b3-flags "";
    proxy_set_header uber-trace-id "";
    proxy_set_header x-ot-span-context "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    location ~* ^/(metrics|health|debug|_status|config)(/|$) {
        return 404;
    }

    location /xmpp-websocket {
        proxy_pass http://jitsi_web_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location /colibri-ws {
        proxy_pass http://jitsi_web_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    location / {
        proxy_pass http://jitsi_web_upstream;
        proxy_http_version 1.1;
    }
}

# Production perimeter note:
# - publish only 80/tcp and 443/tcp on nginx plus 10000/udp on jitsi-jvb
# - backend, Keycloak, PostgreSQL, Redis, Vault and monitoring surfaces stay on private trust zones
