{
  "name": "custom-jitsi-portal-frontend",
  "description": "Qwik SSR frontend for Custom Jitsi Portal",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build.types && npm run build.client && npm run build.server && npm run lint",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build --ssr src/entry.express.tsx --outDir dist/server",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "npm run start",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings=0",
    "lint:strict": "eslint \"src/**/*.ts*\" --max-warnings=0",
    "lint:architecture": "eslint \"src/routes/**/*.ts*\"",
    "lint:architecture:strict": "eslint \"src/routes/**/*.ts*\" --max-warnings=0",
    "lint:layers:strict": "eslint \"src/lib/**/*.ts*\" --max-warnings=0",
    "verify:architecture": "npm run lint:architecture:strict && npm run lint:layers:strict",
    "preview": "npm run build && vite preview --open",
    "start": "node server/entry.express.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:ssr": "npm run build && node scripts/verify-ssr.mjs",
    "qwik": "qwik",
    "generate:api": "npm --prefix .. run openapi:generate && npm --prefix .. run frontend:api-types:generate"
  },
  "dependencies": {
    "@qwik-ui/headless": "0.7.7",
    "express": "^5.2.1",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@qwik.dev/core": "2.0.0-beta.38",
    "@qwik.dev/router": "2.0.0-beta.38",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.0",
    "eslint": "10.8.0",
    "eslint-plugin-qwik": "2.0.0-beta.38",
    "globals": "17.8.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@builder.io/qwik": "npm:@qwik.dev/core@2.0.0-beta.38",
    "@builder.io/qwik-city": "npm:@qwik.dev/router@2.0.0-beta.38",
    "@redocly/openapi-core": {
      "minimatch": "10.2.6"
    },
    "@azure/functions": {
      "uuid": "11.1.1"
    },
    "vite-imagetools": {
      "sharp": "0.35.0"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
