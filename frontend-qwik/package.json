{
  "name": "custom-jitsi-portal-frontend",
  "description": "Qwik SSR frontend for Custom Jitsi Portal",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build.types && npm run build.client && npm run build.server && npm run lint",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build --ssr src/entry.express.tsx --outDir server/build",
    "build.types": "node node_modules/@typescript/native/bin/tsc --incremental --noEmit",
    "deploy": "npm run start",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings=0",
    "lint:strict": "eslint \"src/**/*.ts*\" --max-warnings=0",
    "lint:architecture": "eslint \"src/routes/**/*.ts*\"",
    "lint:architecture:strict": "eslint \"src/routes/**/*.ts*\" --max-warnings=0",
    "lint:layers:strict": "eslint \"src/lib/**/*.ts*\" --max-warnings=0",
    "verify:architecture": "npm run lint:architecture:strict && npm run lint:layers:strict && vitest run src/__tests__/architecture-import-guard.test.ts",
    "preview": "npm run build && vite preview --open",
    "start": "node server/entry.express.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:ssr": "npm run build && node scripts/verify-ssr.mjs",
    "qwik": "qwik",
    "generate:api": "npm --prefix .. run openapi:generate && npm --prefix .. run frontend:api-types:generate"
  },
  "dependencies": {
    "@qwik-ui/headless": "0.7.7",
    "express": "^5.2.1",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@qwik.dev/core": "2.0.0-beta.45",
    "@qwik.dev/router": "2.0.0-beta.45",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-qwik": "2.0.0-beta.45",
    "globals": "17.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "4.1.11",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "vitest": "$vitest",
    "@builder.io/qwik": "npm:@qwik.dev/core@2.0.0-beta.45",
    "@builder.io/qwik-city": "npm:@qwik.dev/router@2.0.0-beta.45",
    "@redocly/openapi-core": {
      "minimatch": "10.2.6"
    },
    "@azure/functions": {
      "uuid": "11.1.1"
    },
    "vite-imagetools": {
      "sharp": "0.35.4"
    }
  },
  "allowScripts": {
    "fsevents": false
  }
}
